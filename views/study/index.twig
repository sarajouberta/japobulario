{% extends "layout.twig" %}

{% block title %}{{ __('study.title') }}{% endblock %}

{% block styles %}
    <link rel="stylesheet" href='/stylesheets/tabs.css'>
    <link rel="stylesheet" href='/stylesheets/study-menu.css'>
{% endblock %}

{#
Pantalla para elegir qué estudiar, igual para vocabulario y kanji (mode). Los enlaces de las pestañas
y del filtro de aprendidas vienen hechos de la ruta (links); studyUrl es el modo estudio de este tipo.
Cada capítulo, sección, lección o categoría lleva su progreso (fragments/progress) y un botón para
marcarlo o desmarcarlo entero (fragments/mark-group), que vuelve aquí (indexUrl) a su ancla (id).
Los enlaces van en una sola línea: si no, el espacio de dentro del <a> también sale subrayado.
#}
{% block body %}
    <div class="study-menu">
        <h1>{{ mode == 'kanji' ? __('study.titleKanji') : __('study.titleVocabulary') }}</h1>

        <!--pestañas: tarjetas de los libros / tarjetas propias creadas con el formulario-->
        <nav class="tabs">
            <a href="{{ links.tabBook }}" class="{{ tab == 'book' ? 'active' : '' }}">{{ __('tabs.book', {'count': bookTotal}) }}</a>
            <a href="{{ links.tabOwn }}" class="{{ tab == 'own' ? 'active' : '' }}">{{ __('tabs.own', {'count': ownTotal}) }}</a>
        </nav>

        <!--qué tarjetas se abren al pulsar un enlace: todas, solo las que faltan por aprender o solo las aprendidas-->
        <p class="learned-filter">
            <span>{{ __('study.learnedFilter') }}</span>
            <a href="{{ links.all }}" class="{{ learned ? '' : 'active' }}">{{ __('study.filterAll') }}</a>
            <a href="{{ links.notLearned }}" class="{{ learned == 'no' ? 'active' : '' }}">{{ __('study.filterNotLearned') }}</a>
            <a href="{{ links.onlyLearned }}" class="{{ learned == 'yes' ? 'active' : '' }}">{{ __('study.filterLearned') }}</a>
        </p>

        {% if tab == 'book' and mode == 'kanji' %}
            {#kanji del libro, por lecciones (el título de la lección en original y al lado su traducción)#}
            <p class="intro">{{ __('study.chooseKanjiBook') }}</p>

            {% if kanjiBook.total == 0 %}
                <p class="info">{{ __('study.noBookKanji') }} <code>npm run import:kanji</code>.</p>
            {% elseif kanjiBook.matching == 0 %}
                <p class="info">{{ learned == 'yes' ? __('study.noneLearned') : __('study.allLearned') }}</p>
            {% else %}
                <div class="all-row">
                    <a class="all" href="{{ studyUrl }}?source=book{{ learnedQuery }}">{{ __('study.allKanjiBook', {'count': kanjiBook.total}) }}</a>
                    {% include 'fragments/progress.twig' with {'learnedCount': kanjiBook.learned, 'count': kanjiBook.total, 'long': true} %}
                </div>
                <ul class="group card">
                    {% for lesson in kanjiBook.lessons %}
                        <li class="row" id="lesson-{{ lesson.lesson }}">
                            <div class="row-title">
                                <a href="{{ studyUrl }}?source=book&chapter={{ lesson.lesson }}{{ learnedQuery }}">{{ __('study.lesson', {'number': lesson.lesson}) }} · {{ lesson.title }}</a>
                                {% if lesson.titleEn %}<span class="translation">{{ lesson.titleEn }}</span>{% endif %}
                            </div>
                            {% include 'fragments/progress.twig' with {'learnedCount': lesson.learned, 'count': lesson.count} %}
                            {% include 'fragments/mark-group.twig' with {'fields': {'source': 'book', 'chapter': lesson.lesson}, 'count': lesson.count, 'learnedCount': lesson.learned, 'anchor': 'lesson-' ~ lesson.lesson} %}
                        </li>
                    {% endfor %}
                </ul>
            {% endif %}

        {% elseif tab == 'book' %}
            <p class="intro">{{ __('study.chooseBook') }}</p>

            {#los dos niveles juntos (con el filtro de aprendidas, solo las que lo cumplen)#}
            {% if bookAll.matching > 0 %}
                <div class="all-row">
                    <a class="all" href="{{ studyUrl }}?source=book{{ learnedQuery }}">{{ __('study.allBooks', {'count': bookAll.total}) }}</a>
                    {% include 'fragments/progress.twig' with {'learnedCount': bookAll.learned, 'count': bookAll.total, 'long': true} %}
                </div>
            {% endif %}

            <div class="levels">
                {% for level in levels %}
                    <section class="level">
                        <h2>{{ level.level }}</h2>
                        {#con el filtro de aprendidas, solo salen las secciones que tienen alguna tarjeta que abrir#}
                        {% if level.total > 0 and level.matching == 0 %}
                            <p class="info">{{ learned == 'yes' ? __('study.noneLearned') : __('study.allLearned') }}</p>
                        {% else %}
                        <div class="all-row">
                            <a class="all" href="{{ studyUrl }}?source=book&level={{ level.level }}{{ learnedQuery }}">{{ __('study.allLevel', {'level': level.level, 'count': level.total}) }}</a>
                            {% include 'fragments/progress.twig' with {'learnedCount': level.learned, 'count': level.total, 'long': true} %}
                        </div>

                        {% for chapter in level.chapters %}
                            {% set chapterId = level.level ~ '-' ~ chapter.chapter %}
                            <article class="chapter" id="{{ chapterId }}">
                                {#el título tal cual viene del libro, y debajo, más pequeña, su traducción;
                                  el título es también el enlace para estudiar el capítulo entero#}
                                <header class="chapter-head">
                                    <h3><a href="{{ studyUrl }}?source=book&level={{ level.level }}&chapter={{ chapter.chapter }}{{ learnedQuery }}">{{ __('study.chapter', {'number': chapter.chapter}) }} · {{ chapter.chapterTitle }}</a></h3>
                                    {% if chapter.chapterTitleEn %}<span class="translation">{{ chapter.chapterTitleEn }}</span>{% endif %}
                                    <div class="chapter-progress">
                                        {% include 'fragments/progress.twig' with {'learnedCount': chapter.learned, 'count': chapter.count, 'long': true} %}
                                        {% include 'fragments/mark-group.twig' with {'fields': {'source': 'book', 'level': level.level, 'chapter': chapter.chapter}, 'count': chapter.count, 'learnedCount': chapter.learned, 'anchor': chapterId} %}
                                    </div>
                                </header>
                                <ul class="group">
                                    {% for section in chapter.sections %}
                                        {% set sectionId = chapterId ~ '-' ~ section.section %}
                                        <li class="row" id="{{ sectionId }}">
                                            <div class="row-title">
                                                <a href="{{ studyUrl }}?source=book&level={{ level.level }}&chapter={{ chapter.chapter }}&section={{ section.section }}{{ learnedQuery }}">{{ section.section }}. {{ section.sectionTitle }}</a>
                                                {% if section.category %}<span class="translation">{{ section.category }}</span>{% endif %}
                                            </div>
                                            {% include 'fragments/progress.twig' with {'learnedCount': section.learned, 'count': section.count} %}
                                            {% include 'fragments/mark-group.twig' with {'fields': {'source': 'book', 'level': level.level, 'chapter': chapter.chapter, 'section': section.section}, 'count': section.count, 'learnedCount': section.learned, 'anchor': sectionId} %}
                                        </li>
                                    {% endfor %}
                                </ul>
                            </article>
                        {% else %}
                            <p class="info">{{ __('study.noBookVocabulary') }} <code>node seeds/import-book-vocabulary.js</code>.</p>
                        {% endfor %}
                        {% endif %}
                    </section>
                {% endfor %}
            </div>

        {% else %}
            <p class="intro">{{ mode == 'kanji' ? __('study.ownIntroKanji') : __('study.ownIntro') }}</p>

            {% if ownTotal == 0 %}
                <p class="info">{{ mode == 'kanji' ? __('study.ownNoneKanji') : __('study.ownNone') }} <a href="/japobulario/flashcards/new">{{ __('study.createCard') }}</a></p>
            {% else %}
                <div class="levels">
                    {% for level in ownLevels %}
                        <section class="level">
                            <h2>{{ level.level }}</h2>
                            {% if level.total == 0 %}
                                <p class="info">{{ __('study.ownNoneLevel') }}</p>
                            {% elseif level.matching == 0 %}
                                <p class="info">{{ learned == 'yes' ? __('study.noneLearned') : __('study.allLearned') }}</p>
                            {% else %}
                                <div class="all-row">
                                    <a class="all" href="{{ studyUrl }}?source=own&level={{ level.level }}{{ learnedQuery }}">{{ __('study.ownAllLevel', {'level': level.level, 'count': level.total}) }}</a>
                                    {% include 'fragments/progress.twig' with {'learnedCount': level.learned, 'count': level.total, 'long': true} %}
                                </div>
                                <ul class="group card">
                                    {% for cat in level.categories %}
                                        {% set catId = 'own-' ~ level.level ~ '-' ~ loop.index %}
                                        <li class="row" id="{{ catId }}">
                                            <div class="row-title">
                                                <a href="{{ studyUrl }}?source=own&level={{ level.level }}&category={{ cat.category|url_encode }}{{ learnedQuery }}">{{ cat.category ? cat.category|e : __('study.noCategory') }}</a>
                                            </div>
                                            {% include 'fragments/progress.twig' with {'learnedCount': cat.learned, 'count': cat.count} %}
                                            {% include 'fragments/mark-group.twig' with {'fields': {'source': 'own', 'level': level.level, 'category': cat.category}, 'count': cat.count, 'learnedCount': cat.learned, 'anchor': catId} %}
                                        </li>
                                    {% endfor %}
                                </ul>
                            {% endif %}
                        </section>
                    {% endfor %}
                </div>
            {% endif %}
        {% endif %}
    </div>
{% endblock %}
