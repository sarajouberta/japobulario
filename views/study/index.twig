{% extends "layout.twig" %}

{% block title %}{{ __('study.title') }}{% endblock %}

{% block styles %}
    <link rel="stylesheet" href='/stylesheets/tabs.css'>
    <link rel="stylesheet" href='/stylesheets/study-menu.css'>
{% endblock %}

{% block body %}
    <div class="study-menu">
        <h1>{{ __('study.titleVocabulary') }}</h1>

        <!--pestañas: tarjetas de los libros / tarjetas propias creadas con el formulario-->
        <nav class="tabs">
            <a href="/japobulario/study" class="{{ tab == 'book' ? 'active' : '' }}">{{ __('tabs.book', {'count': bookTotal}) }}</a>
            <a href="/japobulario/study?tab=own" class="{{ tab == 'own' ? 'active' : '' }}">{{ __('tabs.own', {'count': ownTotal}) }}</a>
        </nav>

        {% if tab == 'book' %}
            <p>{{ __('study.chooseBook') }}</p>

            <div class="levels">
                {% for level in levels %}
                    <section class="level">
                        <h2>{{ level.level }}</h2>
                        <p>
                            <a class="all" href="/japobulario/study/vocabulary?source=book&level={{ level.level }}">
                                {{ __('study.allLevel', {'level': level.level, 'count': level.total}) }}
                            </a>
                        </p>

                        {% for chapter in level.chapters %}
                            {#el título tal cual viene del libro; al lado, más pequeña, su traducción#}
                            <h3>{{ __('study.chapter', {'number': chapter.chapter}) }} · {{ chapter.chapterTitle }}
                                {% if chapter.chapterTitleEn %}<span class="translation">{{ chapter.chapterTitleEn }}</span>{% endif %}
                            </h3>
                            <ul>
                                {% for section in chapter.sections %}
                                    <li>
                                        <a href="/japobulario/study/vocabulary?source=book&level={{ level.level }}&chapter={{ chapter.chapter }}&section={{ section.section }}">
                                            {{ section.section }}. {{ section.sectionTitle }}
                                        </a>
                                        {% if section.category %}<span class="translation">{{ section.category }}</span>{% endif %}
                                        <span class="info">· {{ section.count }}</span>
                                    </li>
                                {% endfor %}
                            </ul>
                        {% else %}
                            <p class="info">{{ __('study.noBookVocabulary') }} <code>node seeds/import-book-vocabulary.js</code>.</p>
                        {% endfor %}
                    </section>
                {% endfor %}
            </div>

        {% else %}
            <p>{{ __('study.ownIntro') }}</p>

            {% if ownTotal == 0 %}
                <p class="info">{{ __('study.ownNone') }} <a href="/japobulario/flashcards/new">{{ __('study.createCard') }}</a></p>
            {% else %}
                <div class="levels">
                    {% for level in ownLevels %}
                        <section class="level">
                            <h2>{{ level.level }}</h2>
                            {% if level.total == 0 %}
                                <p class="info">{{ __('study.ownNoneLevel') }}</p>
                            {% else %}
                                <p>
                                    <a class="all" href="/japobulario/study/vocabulary?source=own&level={{ level.level }}">
                                        {{ __('study.ownAllLevel', {'level': level.level, 'count': level.total}) }}
                                    </a>
                                </p>
                                <ul>
                                    {% for cat in level.categories %}
                                        <li>
                                            <a href="/japobulario/study/vocabulary?source=own&level={{ level.level }}&category={{ cat.category|url_encode }}">
                                                {{ cat.category ?: __('study.noCategory') }}
                                            </a>
                                            <span class="info">{{ cat.count }}</span>
                                        </li>
                                    {% endfor %}
                                </ul>
                            {% endif %}
                        </section>
                    {% endfor %}
                </div>
            {% endif %}
        {% endif %}
    </div>
{% endblock %}
