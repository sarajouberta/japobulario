<!-- Vista para las flashcards: -->
{% extends "layout.twig" %}

{% block styles %}
    <link rel="stylesheet" href='/stylesheets/tabs.css'>
{% endblock %}

{% block body %}
    <h1> A VER CÓMO MUESTRO YO LAS FLASHCARDS XDXXD</h1>

    <!--pestañas: tarjetas propias creadas con el formulario / tarjetas de los libros-->
    <nav class="tabs">
        <a href="/japobulario/flashcards" class="{{ tab == 'mias' ? 'active' : '' }}">Mis tarjetas ({{ ownTotal }})</a>
        <a href="/japobulario/flashcards?tab=libros" class="{{ tab == 'libros' ? 'active' : '' }}">Libros ({{ bookTotal }})</a>
    </nav>

    {% if flashcards.length > 0 %}
        <!--cambio ul por div para usar flexbox-->
        <div class="flashcard-container">
            {% for card in flashcards %}
                <!-- cambio li: articles.
                <hr> horizontal rule" (regla horizontal)-->
                <article class="flashcard">
                    <!--¡¡ refactorizar !!-->
                    <!--cada tarjeta se muestra según su tipo (kanji / vocabulario)-->
                    {% if card.type == 'kanji' %}
                        <div class="kanji-box">
                            <h2>{{ card.kanji }}</h2>
                        </div>
                        <p><strong>Lectura kun:</strong> {{ card.kunReading }}</p>
                        <p><strong>Lectura on:</strong> {{ card.onReading }}</p>
                        <p><strong>Significado:</strong> {{ card.meaning }}</p>
                        <p><strong>Nivel:</strong> {{ card.level }}</p>

                    {% elseif card.type == 'vocabulary' %}
                        <div class="kanji-box">
                            <h2>{{ card.word }}</h2>
                        </div>
                        {% if card.reading and card.reading != card.word %}
                            <p><strong>Lectura:</strong> {{ card.reading }}</p>
                        {% endif %}
                        <p><strong>Significado:</strong> {{ card.meaning }}</p>
                        <p><strong>Nivel:</strong> {{ card.level }}</p>
                        <p><strong>Categoría:</strong> {{ card.category }}</p>

                    {% else %}
                        <div class="kanji-box">
                            <h2>{{ card.kanji }}</h2>
                        </div>
                        <p><strong>Lectura kun:</strong> {{ card.kunReading }}</p>
                        <p><strong>Lectura on:</strong> {{ card.onReading }}</p>
                        <p><strong>Significado:</strong> {{ card.meaning }}</p>
                        <p><strong>Nivel:</strong> {{ card.level }}</p>
                        <p><strong>Categoría:</strong> {{ card.category }}</p>
                    {% endif %}
                </article>
            {% endfor %}
        </div>
    {% else %}
        <p>{{ tab == 'mias' ? 'Todavía no has creado tarjetas.' : 'No hay tarjetas de los libros. Ejecuta node seeds/import-book-vocabulary.js' }}</p>
    {% endif %}

        <p><a href="/japobulario/flashcards/new">Añadir nueva flashcard</a></p>

    {% endblock %}