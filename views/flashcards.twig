<!-- Vista para las flashcards: -->
{% extends "layout.twig" %}

{% block styles %}
    <link rel="stylesheet" href='/stylesheets/tabs.css'>
{% endblock %}

{% block body %}
    <h1>{{ __('flashcards.title') }}</h1>

    <!--pestañas: tarjetas propias creadas con el formulario / tarjetas de los libros-->
    <nav class="tabs">
        <a href="/japobulario/flashcards" class="{{ tab == 'own' ? 'active' : '' }}">{{ __('tabs.own', {'count': ownTotal}) }}</a>
        <a href="/japobulario/flashcards?tab=book" class="{{ tab == 'book' ? 'active' : '' }}">{{ __('tabs.book', {'count': bookTotal}) }}</a>
    </nav>

    {% if flashcards.length > 0 %}
        <!--cambio ul por div para usar flexbox-->
        <div class="flashcard-container">
            {% for card in flashcards %}
                <!-- cambio li: articles.
                <hr> horizontal rule" (regla horizontal)-->
                <article class="flashcard">
                    <!--¡¡ refactorizar !!-->
                    <!--cada tarjeta se muestra según su tipo (kanji / vocabulario)-->
                    {% if card.type == 'kanji' %}
                        <div class="kanji-box">
                            <h2>{{ card.kanji }}</h2>
                        </div>
                        <p><strong>{{ __('card.kunReading') }}:</strong> {{ card.kunReading }}</p>
                        <p><strong>{{ __('card.onReading') }}:</strong> {{ card.onReading }}</p>
                        <p><strong>{{ __('card.meaning') }}:</strong> {{ card.meaning }}</p>
                        <p><strong>{{ __('card.level') }}:</strong> {{ card.level }}</p>

                    {% elseif card.type == 'vocabulary' %}
                        <div class="kanji-box">
                            <h2>{{ card.word }}</h2>
                        </div>
                        {% if card.reading and card.reading != card.word %}
                            <p><strong>{{ __('card.reading') }}:</strong> {{ card.reading }}</p>
                        {% endif %}
                        <p><strong>{{ __('card.meaning') }}:</strong> {{ card.meaning }}</p>
                        <p><strong>{{ __('card.level') }}:</strong> {{ card.level }}</p>
                        <p><strong>{{ __('card.category') }}:</strong> {{ card.category }}</p>

                    {% else %}
                        <div class="kanji-box">
                            <h2>{{ card.kanji }}</h2>
                        </div>
                        <p><strong>{{ __('card.kunReading') }}:</strong> {{ card.kunReading }}</p>
                        <p><strong>{{ __('card.onReading') }}:</strong> {{ card.onReading }}</p>
                        <p><strong>{{ __('card.meaning') }}:</strong> {{ card.meaning }}</p>
                        <p><strong>{{ __('card.level') }}:</strong> {{ card.level }}</p>
                        <p><strong>{{ __('card.category') }}:</strong> {{ card.category }}</p>
                    {% endif %}
                </article>
            {% endfor %}
        </div>
    {% else %}
        <p>{{ tab == 'own' ? __('flashcards.emptyOwn') : __('flashcards.emptyBook') }}</p>
    {% endif %}

        <p><a href="/japobulario/flashcards/new">{{ __('flashcards.addNew') }}</a></p>

    {% endblock %}