<!DOCTYPE html>
<html lang="{{ locale }}">
  <head>
    <meta charset="utf-8">
    <!--en el móvil, que la página use el ancho real de la pantalla (sin esto, el navegador la pinta
        como si fuera de ordenador, unos 980px, y la encoge: se ve todo muy pequeño)-->
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <!--cada vista puede definir su título con el bloque title; si no, sale "Japobulario"-->
    <title>{% block title %}Japobulario{% endblock %}</title>
    <!--icono de la pestaña del navegador-->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <!--app instalable (PWA): manifiesto para "Añadir a pantalla de inicio" en el móvil, icono para
        iPhone y color de la barra del sistema (el gris del menú)-->
    <link rel="manifest" href="/manifest.webmanifest">
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png">
    <meta name="theme-color" content="#333333">
    <!--link para fuente externa tipo pincel (kanji)-->
    <link href="https://fonts.googleapis.com/css2?family=Yuji+Syuku&display=swap" rel="stylesheet">
    <!--estilos comunes a toda la web (fondo de la página...)-->
    <link rel='stylesheet' href='/stylesheets/common.css' />
    <!--menú de navegación común a todas las páginas-->
    <link rel='stylesheet' href='/stylesheets/menu.css' />
    <!--bloque para poder añadir hoja para modos de estudio-->
    {% block styles %}{% endblock %}
  </head>
  <body>
    <!--MENÚ: al estar en layout, aparece en todas las vistas que heredan de él-->
    <nav class="main-menu">
      <a class="brand" href="/japobulario">Japobulario</a>
      <!--los enlaces de la app solo se muestran con la sesión iniciada (sin sesión, todo lleva al login)-->
      {% if currentUser %}
      <!--botón "Menú", solo en el móvil (ver menu.css): la casilla oculta guarda si está abierto y los
          enlaces y el usuario se enseñan cuando está marcada. Sin JavaScript-->
      <input type="checkbox" id="menu-toggle" class="menu-toggle">
      <label for="menu-toggle" class="menu-button">{{ __('menu.menu') }}</label>
      <ul>
        <li><a href="/japobulario">{{ __('menu.home') }}</a></li>
        <li><a href="/japobulario/study">{{ __('menu.studyVocabulary') }}</a></li>
        <li><a href="/japobulario/study?mode=kanji">{{ __('menu.studyKanji') }}</a></li>
        <li><a href="/japobulario/flashcards">{{ __('menu.flashcards') }}</a></li>
        <li><a href="/japobulario/flashcards/new">{{ __('menu.newCard') }}</a></li>
      </ul>
      {% endif %}
      <!--selector de idioma: guarda la elección en una cookie (ruta /lang/:locale en routes/index.js)-->
      <div class="lang-switch" title="{{ __('menu.language') }}">
        <a href="/lang/es" class="{{ locale == 'es' ? 'active' : '' }}">ES</a>
        |
        <a href="/lang/en" class="{{ locale == 'en' ? 'active' : '' }}">EN</a>
      </div>
      <!--usuario de la sesión y cerrar sesión (POST, ver routes/auth.js)-->
      {% if currentUser %}
      <form class="user-box" action="/logout" method="POST">
        <span>{{ __('auth.loggedAs', {'name': currentUser.name}) }}</span>
        <button type="submit">{{ __('menu.logout') }}</button>
      </form>
      {% endif %}
    </nav>

    <main>{% block body %}{% endblock %}</main>

    <!--pie de página: aviso de que la web está en desarrollo. Va en el layout, así sale en todas.
        La llave inglesa está dibujada en SVG (no es un icono de fuente ni un emoji)-->
    <footer class="dev-banner">
      <svg class="wrench" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"
           stroke-linecap="round" aria-hidden="true" focusable="false">
        <!--cabeza: arco casi cerrado, con la boca abierta hacia la derecha-->
        <path d="M18.6 4.4a4.3 4.3 0 1 0 0 7.2"/>
        <!--mango-->
        <path d="M13 11 4.6 19.4"/>
      </svg>
      {{ __('menu.developedBy') }}
    </footer>

    <!--service worker: pantalla de espera mientras el servidor de Render despierta (ver public/sw.js)-->
    <script>
      if ('serviceWorker' in navigator) navigator.serviceWorker.register('/sw.js');
    </script>

    {% block scripts %}{% endblock %}
  </body>
</html>
