<!DOCTYPE html>
<html lang="{{ locale }}">
  <head>
    <!--cada vista puede definir su título con el bloque title; si no, sale "Japobulario"-->
    <title>{% block title %}Japobulario{% endblock %}</title>
    <link rel='stylesheet' href='/stylesheets/style.css' />
    <!--link para fuente externa tipo pincel (kanji)-->
    <link href="https://fonts.googleapis.com/css2?family=Yuji+Syuku&display=swap" rel="stylesheet">
    <!--menú de navegación común a todas las páginas-->
    <link rel='stylesheet' href='/stylesheets/menu.css' />
    <!--bloque para poder añadir hoja para modos de estudio-->
    {% block styles %}{% endblock %}
  </head>
  <body>
    <!--MENÚ: al estar en layout, aparece en todas las vistas que heredan de él-->
    <nav class="main-menu">
      <a class="brand" href="/japobulario">Japobulario</a>
      <ul>
        <li><a href="/japobulario">{{ __('menu.home') }}</a></li>
        <li><a href="/japobulario/study">{{ __('menu.studyVocabulary') }}</a></li>
        <li><a href="/japobulario/study/kanji">{{ __('menu.studyKanji') }}</a></li>
        <li><a href="/japobulario/flashcards">{{ __('menu.flashcards') }}</a></li>
        <li><a href="/japobulario/flashcards/new">{{ __('menu.newCard') }}</a></li>
      </ul>
      <!--selector de idioma: guarda la elección en una cookie (ruta /lang/:locale en routes/index.js)-->
      <div class="lang-switch" title="{{ __('menu.language') }}">
        <a href="/lang/es" class="{{ locale == 'es' ? 'active' : '' }}">ES</a>
        |
        <a href="/lang/en" class="{{ locale == 'en' ? 'active' : '' }}">EN</a>
      </div>
    </nav>

    {% block body %}{% endblock %}

    {% block scripts %}{% endblock %}
  </body>
</html>
