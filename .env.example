# Plantilla para conectar con MongoDB Atlas.
# 1. Copia este archivo como .env.atlas (ese nombre está en .gitignore, nunca se sube al repositorio)
# 2. Pon tu dirección de conexión de Atlas, con el usuario y la contraseña de la base de datos
# 3. Usa: npm run start:atlas   (arrancar la app contra Atlas)
#         npm run import:atlas  (cargar el vocabulario de los libros en Atlas)
# Sin este archivo, npm start usa el MongoDB local (config/database.js).

MONGO_URL=mongodb+srv://USUARIO:CONTRASEÑA@TU-CLUSTER.xxxxx.mongodb.net/japobulario?retryWrites=true&w=majority

# Solo al publicar la app (en la configuración del hosting, no hace falta en .env.atlas):
#   NODE_ENV=production
#   SESSION_SECRET=una cadena larga y aleatoria (firma las cookies de sesión). Se puede generar con:
#       node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Con NODE_ENV=production la app no arranca si falta SESSION_SECRET.
